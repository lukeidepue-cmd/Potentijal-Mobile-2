{
  "expo": {
    "name": "AthleteCraft",
    "slug": "my-first-app",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myfirstapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:potentijal.com"
      ],
      "bundleIdentifier": "com.lukedepue.myfirstapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "myfirstapp",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1513"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "AthleteCraft uses your photo library so you can choose a profile picture and add highlight videos.",
          "cameraPermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "AthleteCraft uses this to understand how the app is used and to improve your experience. We do not use this for advertising."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01792316-d8cf-483b-a425-8fbf73fa7a9c"
      },
      "revenueCatPublicApiKey": "appl_gRgPvKhKRMxxLkJWNzJKKXsRfbD",
      "supabaseUrl": "https://your-project.supabase.co",
      "supabaseAnonKey": "your-supabase-anon-key"
    }
  }
}
