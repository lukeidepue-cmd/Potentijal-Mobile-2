# Copy to .env and fill in. Never commit .env.
# Supabase (client-safe: anon key only; service role key is server-side only in Supabase secrets)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat: use the PUBLIC SDK key only (from RevenueCat dashboard)
EXPO_PUBLIC_REVENUECAT_API_KEY=your-public-sdk-key-here

# PostHog (optional; client-safe)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Do NOT add OpenAI, Loops, Supabase service role, or RevenueCat secret keys here.
# Those are set in Supabase Edge Function secrets (dashboard), not in app .env.
